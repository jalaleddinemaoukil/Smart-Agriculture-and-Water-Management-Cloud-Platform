# Example environment variables for local development.
# COPY this file to `.env.local` (or `.env`) and fill in the real values.
# NEVER commit real secrets to source control. Keep .env files out of git.

# Supabase (client-side) - Vite exposes env variables prefixed with VITE_ to the browser.
# Use the project URL and ANON (public) key for client usage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Bridge/service usage (server-side) - DON'T prefix service keys with VITE_.
# Keep these in server/bridge environment (bridge/.env or cloud secret store).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notes:
# - For local Supabase development, you can run the Supabase emulator or use your
#   real Supabase project's credentials (for testing only).
# - Ensure your real `.env.local` or `.env` is listed in `.gitignore` to avoid leaks.
# - The frontend should only use the ANON key. Do not expose the Service Role key
#   in the browser. Use it server-side (e.g., in the `bridge/` service or Edge Functions).
